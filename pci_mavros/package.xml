<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pci_mavros</name>
  <version>0.1.0</version>
  <description>Planner control interface for ArduCopter (GUIDED) through mavros</description>
  <maintainer email="luiscarpi1989@gmail.com">lateforwork04</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>planner_common</depend>
  <depend>planner_control_interface</depend>
  <exec_depend>mavros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
